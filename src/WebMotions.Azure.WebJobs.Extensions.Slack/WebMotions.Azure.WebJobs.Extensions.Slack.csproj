<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\common.props" />
  <PropertyGroup>
    <Version>$(SlackVersion)</Version>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Description>This package contains binding extensions for Slack</Description>
    <PackageId>WebMotions.Azure.WebJobs.Extensions.Slack</PackageId>
    <Title>WebMotions Azure WebJobs Slack Extension</Title>
    <PackageDescription>A Slack binding that allows you to easily send rich slack messages after your job functions complete.</PackageDescription>
    <PackageTags>Slack;Azure WebJobs</PackageTags>
	<GenerateFunctionsExtensionsMetadata>true</GenerateFunctionsExtensionsMetadata>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="10.2.3" />
    <PackageReference Include="Microsoft.Azure.WebJobs" Version="3.0.44" />
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	<!--Azure functions host still runs on .NET 8. Once it runs on .NET 10, update this. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Dynamic.Runtime" Version="4.3.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
